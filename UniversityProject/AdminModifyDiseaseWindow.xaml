<Window x:Class="UniversityProject.AdminModifyDiseaseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UniversityProject"
        mc:Ignorable="d"
        Title="AdminModifyDiseaseWindow" Height="450" Width="850" Loaded="Window_Loaded" x:Name="MainWin">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Label Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">Назва:</Label>
            <TextBox Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" x:Name="name"></TextBox>
            <Label Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">Вид:</Label>
            <ComboBox Grid.Row="1" Grid.Column="2"  VerticalAlignment="Center" x:Name="CategoryCombo"></ComboBox>
            <Label Grid.Row="2" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">Фото хвороби:</Label>
            <Button x:Name="UploadBtn" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" Click="Button_Click">Загрузити</Button>
            <Image Grid.Row="2" Grid.Column="3" x:Name="diseaseImage"></Image>
            <Label Grid.Row="2" Grid.Column="2" VerticalAlignment="Bottom" x:Name="uploadResult"></Label>
            <Button x:Name="NextBtn" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" Grid.ColumnSpan="3" HorizontalAlignment="Left" Margin="106,0,0,0" Width="107" Click="Button_Click_3">Додати</Button>
        </Grid>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" x:Name="Toolbar">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <ComboBox VerticalAlignment="Center" x:Name="symptomsComboBox" SelectedIndex="0"></ComboBox>
                <Slider x:Name="symptomPower" Grid.Column="1" VerticalAlignment="Center" Minimum="1" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" TickPlacement="BottomRight"></Slider>
                <Button Grid.Column="2" VerticalAlignment="Center" Click="Button_Click_1">Додати</Button>
                <Button Grid.Column="3" VerticalAlignment="Center" Click="Button_Click_2">Видалити виділене</Button>
            </Grid>
            <ListView Grid.Row="1" SelectedValuePath="Id" x:Name="symptomsListView">
                <ListView.View>
                    <GridView>
                        <GridViewColumn DisplayMemberBinding="{Binding Name}" Width="150">Назва</GridViewColumn>
                        <GridViewColumn DisplayMemberBinding="{Binding Power}" Width="50">Сила</GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>
    </Grid>
</Window>
